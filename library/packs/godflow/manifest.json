  "laneNotes": [
    "No drums: the pack has no GodFlow drum MIDI, and Flowstate does not make fake drum entries.",
    "No melodies: v1's five pop 'melody' files are chord stacks on every onset, so they are pop chords here (owner's call, 2026-10-01)."
  ],
  "omitted": [
    {
      "file": "bass-01.mid",
      "reason": "Notes from C2 to B4 leave the bass range C1-C4; the line is also 32 bars with 16 empty ones."
    },
    {
      "file": "bass-03.mid",
      "reason": "A C#4 in the last-bar fill leaves the bass range C1-C4."
    },
    {
      "file": "bass-04.mid",
      "reason": "A dancehall line between G3 and F4, above the bass range C1-C4."
    }
  ],
