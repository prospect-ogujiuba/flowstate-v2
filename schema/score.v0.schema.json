{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ir": {
      "type": "string",
      "const": "flowstate.score.v0"
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "properties": {
        "tempo": {
          "type": "number",
          "description": "BPM"
        },
        "meterNumerator": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "meterDenominator": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tonic": {
          "type": "string",
          "enum": [
            "C",
            "C#",
            "Db",
            "D",
            "D#",
            "Eb",
            "E",
            "F",
            "F#",
            "Gb",
            "G",
            "G#",
            "Ab",
            "A",
            "A#",
            "Bb",
            "B"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "major",
            "minor",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "locrian",
            "harmonic_minor",
            "melodic_minor",
            "major_pentatonic",
            "minor_pentatonic",
            "blues"
          ]
        },
        "bars": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Clip length in bars; authoritative"
        },
        "swing": {
          "type": "number",
          "description": "0 straight .. 0.5 heavy swing on off-beat steps"
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tempo",
        "meterNumerator",
        "meterDenominator",
        "tonic",
        "mode",
        "bars",
        "swing",
        "style"
      ],
      "additionalProperties": false
    },
    "form": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startBar": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "bars": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "energy": {
            "type": "number",
            "description": "0..1"
          }
        },
        "required": [
          "name",
          "startBar",
          "bars",
          "energy"
        ],
        "additionalProperties": false
      }
    },
    "harmony": {
      "anyOf": [
        {
          "type": "string",
          "description": "Compact form: \"<chord>:<beats>\" tokens from bar 1 beat 1 in sequence, \"r:<beats>\" for no chord, e.g. \"Dm9:4 | G13:4 | Em7:2 A7:2\""
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bar": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "1-based bar"
              },
              "beat": {
                "type": "number",
                "description": "1-based beat within the bar"
              },
              "beats": {
                "type": "number",
                "description": "Duration in beats"
              },
              "symbol": {
                "type": "string",
                "description": "Chord symbol, e.g. Cm9, G13, F/A, Bb7#11"
              }
            },
            "required": [
              "bar",
              "beat",
              "beats",
              "symbol"
            ],
            "additionalProperties": false
          },
          "description": "Chord-object form (older scores)"
        }
      ]
    },
    "motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "description": "Compact form: \"<pitch>:<beats>[!]\" tokens played in sequence, e.g. \"5:.75! 4:.25 b3:1 r:.5 1+:1/3\""
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "degree": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "1-based scale degree of the mode; 8 = tonic an octave up"
                    },
                    "octave": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "Octave offset from the part's register centre"
                    },
                    "alter": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "-1, 0 or +1 semitone chromatic alteration"
                    },
                    "beat": {
                      "type": "number",
                      "description": "Onset offset in beats from motif start (0-based)"
                    },
                    "beats": {
                      "type": "number",
                      "description": "Duration in beats"
                    },
                    "accent": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "degree",
                    "octave",
                    "alter",
                    "beat",
                    "beats",
                    "accent"
                  ],
                  "additionalProperties": false
                },
                "description": "Note-object form (older scores)"
              }
            ]
          }
        },
        "required": [
          "id",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "chords",
              "pad",
              "arp",
              "bass",
              "melody",
              "counter",
              "drums"
            ]
          },
          "name": {
            "type": "string"
          },
          "low": {
            "type": "string",
            "description": "Note name with octave, e.g. C4 (=MIDI 60), F#2, Bb5"
          },
          "high": {
            "type": "string",
            "description": "Note name with octave, e.g. C4 (=MIDI 60), F#2, Bb5"
          },
          "grid": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Steps per beat for step strings (4 = 16ths in 4/4, 3 = triplets)"
          },
          "velocity": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startBar": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "endBar": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Inclusive"
                },
                "rhythm": {
                  "description": "Step string; tokens depend on role (see spec)",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "voicing": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "close",
                        "open",
                        "drop2",
                        "drop3",
                        "rootless",
                        "shell",
                        "spread",
                        "quartal",
                        "power"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "arpPattern": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "up",
                        "down",
                        "updown",
                        "random",
                        "chord_tones"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "motif": {
                  "description": "Motif id for melody/counter",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "transforms": {
                  "description": "e.g. transpose:+2, invert, retrograde, displace:+0.5, augment, diminish, octave:+1",
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "repeatEvery": {
                  "description": "Motif repeat period in beats; 0 = once",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "drums": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "voice": {
                            "type": "string",
                            "enum": [
                              "kick",
                              "snare",
                              "clap",
                              "rim",
                              "closed_hat",
                              "pedal_hat",
                              "open_hat",
                              "low_tom",
                              "mid_tom",
                              "high_tom",
                              "crash",
                              "ride",
                              "ride_bell",
                              "shaker",
                              "tambourine",
                              "cowbell"
                            ]
                          },
                          "steps": {
                            "type": "string",
                            "description": "Step string: x hit, X accent, g ghost, . rest; | separates bars"
                          }
                        },
                        "required": [
                          "voice",
                          "steps"
                        ],
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "groove": {
                  "description": "Drums: a named groove; lanes in `drums` only add voices it doesn't have",
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "four_on_floor",
                        "tech_house",
                        "boom_bap",
                        "lofi",
                        "trap",
                        "drill",
                        "dembow",
                        "afrobeats",
                        "funk",
                        "rock",
                        "pop",
                        "ballad",
                        "neo_soul",
                        "dnb",
                        "half_time",
                        "cinematic_toms",
                        "sparse_pulse",
                        "jazz_swing",
                        "brush_swing",
                        "jazz_waltz",
                        "waltz",
                        "six_eight",
                        "gospel_shuffle"
                      ],
                      "description": "Named drum groove (docs/ir-spec.md, Grooves)",
                      "grooves": {
                        "four_on_floor": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "house: kick on every beat, clap on 2 and 4, off-beat open hats, rolling 16th shaker"
                        },
                        "tech_house": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "tech house: four-on-the-floor kick, clap on 2 and 4, off-beat pedal hat, ride on the beat, a pushed ghost snare"
                        },
                        "boom_bap": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "boom bap: syncopated kick, laid-back snare on 2 and 4, 8th hats (pair with swing around 0.15)"
                        },
                        "lofi": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "lofi: soft kick with an off-beat push, late snare and clap on 2 and 4, ghosted hats (pair with swing)"
                        },
                        "trap": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "trap (half-time at 130-170 BPM): sparse kicks, clap on 3, 8th hats with a 32nd roll before the bar line"
                        },
                        "drill": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "UK drill: half-time snare on 3 then on 4 in bar 2, sliding kicks off the downbeat, tresillo hats"
                        },
                        "dembow": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "reggaeton dembow: kick on every beat, snare on the 3-3-2 dembow accents (soft, then strong), light 8th hats"
                        },
                        "afrobeats": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "afrobeats: kick on 1, the and of 2, and 4; a rim on the skipping accents instead of a backbeat; accented 16th shaker"
                        },
                        "funk": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "funk (Funky Drummer): syncopated kick, backbeat snare with ghost notes, accented 16th hats opening on the e of 2 and 4"
                        },
                        "rock": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "rock: kick on 1 and 3 with pushes, snare on 2 and 4, 8th hats, crash on the first downbeat"
                        },
                        "pop": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "pop: kick on 1 and the and of 2 and 3, clap and tambourine on 2 and 4, 8th hats"
                        },
                        "ballad": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "ballad: soft kick on 1 and 3, cross-stick on 2 and 4, gentle 8th hats"
                        },
                        "neo_soul": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "neo-soul: behind-the-beat pocket, late snare and hats, ghosted 16ths"
                        },
                        "dnb": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "drum and bass: two-step kick and snare with ghost snares, ride 8ths, off-beat hats"
                        },
                        "half_time": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "half-time: kick on 1, snare on 3, 8th hats; slow hip hop and builds"
                        },
                        "cinematic_toms": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "cinematic: big low-tom ostinato over kick on 1 and 3, crash on the first downbeat"
                        },
                        "sparse_pulse": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "ambient: a soft pulse; kick on 1, ride quarter notes, light shaker"
                        },
                        "jazz_swing": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "jazz swing (triplet grid): spang-a-lang ride, hi-hat foot on 2 and 4, feathered kick, cross-stick on 4"
                        },
                        "brush_swing": {
                          "meter": [
                            4,
                            4
                          ],
                          "description": "brushes (triplet grid): swirling brush snare, feathered kick, hi-hat foot on 2 and 4"
                        },
                        "jazz_waltz": {
                          "meter": [
                            3,
                            4
                          ],
                          "description": "jazz waltz (triplet grid): skipping ride, hi-hat foot on 2 and 3, feathered kick"
                        },
                        "waltz": {
                          "meter": [
                            3,
                            4
                          ],
                          "description": "waltz: kick on 1, cross-stick on 2 and 3, 8th hats"
                        },
                        "six_eight": {
                          "meter": [
                            6,
                            8
                          ],
                          "description": "6/8: kick on 1, snare on 4, every eighth on the hats with accents on 1 and 4; ballads and folk"
                        },
                        "gospel_shuffle": {
                          "meter": [
                            6,
                            8
                          ],
                          "description": "gospel 6/8: kick on 1 with a pickup on 6, snare on 4 with a ghost, accented hats"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fill": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "none",
                        "snare_roll",
                        "tom_run",
                        "kick_build",
                        "crash_end",
                        "half_time_break"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bar": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "beat": {
                            "type": "number"
                          },
                          "beats": {
                            "type": "number"
                          },
                          "pitch": {
                            "type": "string",
                            "description": "Note name with octave, e.g. C4 (=MIDI 60), F#2, Bb5"
                          },
                          "velocity": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "bar",
                          "beat",
                          "beats",
                          "pitch",
                          "velocity"
                        ],
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "articulation": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "legato",
                        "normal",
                        "staccato"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "startBar",
                "endBar"
              ],
              "additionalProperties": false
            }
          },
          "density": {
            "description": "Set by simplify/intensify: 0..1, 0.5 or absent = as written",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "humanize": {
            "description": "Set by the humanize tweak: 0 = on the grid, absent = the default 0.3, 1 = loose",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "seed": {
            "description": "Set by re-roll: this part's own seed for seeded realization choices",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "name",
          "low",
          "high",
          "grid",
          "velocity",
          "blocks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ir",
    "title",
    "context",
    "form",
    "harmony",
    "motifs",
    "parts"
  ],
  "additionalProperties": false
}
